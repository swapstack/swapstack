# Display name shown on a user's device.
APP_NAME=Swapstack
# Expo project slug.
APP_SLUG=swapstack
# Deep-link URL scheme.
APP_SCHEME=swapstack
# Unique Apple bundle identifier.
IOS_BUNDLE_ID=com.swapstack.app
# Unique Android application ID.
ANDROID_PACKAGE=com.swapstack.app

# Provider configuration ("mock" or "supabase" for auth/data, "mock" or "revenuecat" for billing).
EXPO_PUBLIC_AUTH_PROVIDER=mock
EXPO_PUBLIC_DATA_PROVIDER=mock
EXPO_PUBLIC_BILLING_PROVIDER=mock

# Required when auth or data uses Supabase. Use the anonymous public key only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Required when billing uses RevenueCat. Purchases require a development build.
EXPO_PUBLIC_REVENUECAT_PUBLIC_SDK_KEY=
